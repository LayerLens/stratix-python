."}], "metadata": {"usage": {"inputTokens": 339, "outputTokens": 92, "totalTokens": 431}, "metrics": {"latencyMs": 0, "timeToFirstByteMs": 764}}}}, "hash": "sha256:63b2fefe15f719722549aac3fe20262f78a2b8be84eb793278dddd6ff098795a", "previous_hash": "sha256:f5958298792f1c02de8d002d7187fb5794076ae23b49128b0830b9d26796017f"}, {"event_type": "agent.identity", "trace_id": "a0114c5f88df453c", "span_id": "41f9189ddd554297", "parent_span_id": "e82ab49d6cdc43e5", "span_name": null, "sequence_id": 29, "timestamp_ns": 1784073877944329000, "payload": {"agent_name": "intake-coordinator", "source": "framework", "framework": "strands"}, "hash": "sha256:5592fa15b72a0a533eb84eaa596fe844498be94275bbf5e0a4d9763387b01bb1", "previous_hash": "sha256:63b2fefe15f719722549aac3fe20262f78a2b8be84eb793278dddd6ff098795a"}], "capture_config": {"l1_agent_io": true, "l2_agent_code": true, "l3_model_metadata": true, "l4a_environment_config": true, "l4b_environment_metrics": true, "l5a_tool_calls": true, "l5b_tool_logic": true, "l5c_tool_environment": true, "l6a_protocol_discovery": true, "l6b_protocol_streams": true, "l6c_protocol_lifecycle": true, "capture_content": true}, "attestation": {"chain": {"events": [{"hash": "sha256:65ef286e7270aea4cf8ca42fef4014262a73c0fb0b134f94c29b9b07a060ab25", "scope": "event", "previous_hash": null, "timestamp": "2026-07-15T00:04:27.819958+00:00"}, {"hash": "sha256:5d355b802bb3765a79f9718db51e39dd760b5b48983281500a49dc433e027f92", "scope": "event", "previous_hash": "sha256:65ef286e7270aea4cf8ca42fef4014262a73c0fb0b134f94c29b9b07a060ab25", "timestamp": "2026-07-15T00:04:27.820120+00:00"}, {"hash": "sha256:002b9bfd2d76ab74806f5592eb19b4f9612049045fac9efceb2c9abef51169f2", "scope": "event", "previous_hash": "sha256:5d355b802bb3765a79f9718db51e39dd760b5b48983281500a49dc433e027f92", "timestamp": "2026-07-15T00:04:29.421263+00:00"}, {"hash": "sha256:27ad0f8fd8d33ed18dc954ba137de935356799528d71adc300c6db199eef1c4f", "scope": "event", "previous_hash": "sha256:002b9bfd2d76ab