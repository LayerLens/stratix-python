a4cbdc8d89ad11f585fc5f0f96667ad66c190574bd97098f1bdbf51ef"}, {"event_type": "cost.record", "trace_id": "ecba2ba3c4f5495c", "span_id": "85bef952272148b4", "parent_span_id": "d072b6d33bc1401e", "span_name": null, "sequence_id": 4, "timestamp_ns": 1784074153675252000, "payload": {"framework": "bedrock_agents", "provider": "aws_bedrock", "tokens_prompt": 872, "tokens_completion": 247, "tokens_total": 1119, "bedrock_trace_id": "33a1e8e5-eaf0-4f37-bf2f-9acbaa6b954a-0", "model": "amazon.nova-micro-v1:0", "cost_usd": 6.51e-05, "aws_request_id": "33a1e8e5-eaf0-4f37-bf2f-9acbaa6b954a"}, "hash": "sha256:70e13fc4e80056914c426f669ddd0f7f1e1cf45b8db190e501295445bead56cc", "previous_hash": "sha256:77173769fffaf5d4edb527e24289072d9146627c8ebe30facad572b07511c9ee"}, {"event_type": "agent.output", "trace_id": "ecba2ba3c4f5495c", "span_id": "d072b6d33bc1401e", "parent_span_id": "d072b6d33bc1401e", "span_name": "bedrock.invoke_agent", "sequence_id": 5, "timestamp_ns": 1784074153790576000, "payload": {"framework": "bedrock_agents", "session_id": "ll-w2-gov-9ad2b069b17d", "latency_ms": 755.747, "output": "Sure, here are the key points to understand the difference between Medicare and Medicaid:\n\n- Medicare: This is a federal health insurance program for people who are 65 or older. Some younger people with disabilities can get Medicare too. Medicare is not based on income. It's funded by a combination of a specific payroll tax and beneficiary premiums.\n\n- Medicaid: This is a joint federal and state program that helps pay for medical costs for some people with low incomes and limited resources. Medicaid is based on income.\n\nSo, to summarize, Medicare is for people based on age, and Medicaid is for people based on income.", "aws_request_id": "33a1e8e5-eaf0-4f37-bf2f-9acbaa6b954a"}, "hash": "sha256:f6c0e5ee41be382aa533adeab5267b07cca02b4961ddf867c14119c6c507e92e", "previous_hash": "sha256:70e13fc4e80056914c426f669ddd0f7f1e1cf45b8db190e501295445bead56cc"}], "capture_config": {"l1_agent_io": true, "l2_agent_code": true, "l3_model_metadata": true, "l4a_environment_config": true, "l4b_environment_metrics": true, "l5a_tool_calls": true, "l5b_tool_logic": true, "l5c_tool_environment": true, "l6a_protocol_discovery": true, "l6b_protocol_streams": true, "l6c_protocol_lifecycle": true, "capture_content": true}, "attestation": {"chain": {"events": [{"hash": "sha256:69ac3389ba9bdbcfd70d95dfc3dc33948b3db7527deb5edcd231da695c4e6063", "scope": "event", "previous_hash": null, "timestamp": "2026-07-15T00:09:11.640341+00:00"}, {"hash": "sha256:200549fa4cbdc8d89ad11f585fc5f0f96667ad66c190574bd97098f1bdbf51ef", "scope": "event", "previous_hash": "sha256:69ac3389ba9bdbcfd70d95dfc3dc33948b3db7527deb5edcd231da695c4e6063", "timestamp": "2026-07-15T00:09:11.641349+00:00"}, {"hash": "sha256:77173769fffaf5d4edb527e24289072d9146627c8ebe30facad572b07511c9ee", "scope": "event", "previous_hash": "sha256:200549fa4cbdc8d89ad11f585fc5f0f96667ad66c190574bd97098f1bdbf51ef", "timestamp": "2026-07-15T00:09:13.673512+00:00"}, {"hash": "sha256:70e13fc4e80056914c426f669ddd0f7f1e1cf45b8db190e501295445bead56cc", "scope": "event", "previous_hash": "sha256:77173769fffaf5d4edb527e24289072d9146627c8ebe30facad572b07511c9ee", "timestamp": "2026-07-15T00:09:13.675302+00:00"}, {"hash": "sha256:f6c0e5ee41be382aa533adeab5267b07cca02b4961ddf867c14119c6c507e92e", "scope": "event", "previous_hash": "sha256:70e13fc4e80056914c426f669ddd0f7f1e1cf45b8db190e501295445bead56cc", "timestamp": "2026-07-15T00:09:13.790767+00:00"}]}, "schema_version": "1.0", "root_hash": "sha256:8f2523ccf9fe1f27837eb1ee919af9d346bb3fcd0c259eece0b4b75174bed4d0"}, "tags": ["layerlens-sample", "industry", "government", "citizen-services", "bedrock-agents"]}
