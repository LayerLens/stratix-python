# Local credentials for live integration tests. Copy to ``.env`` (which is
# gitignored) and fill in real values. CI passes these as real env vars.
#
# Live tests skip if no key is set; nothing else depends on these.

# OpenAI (default LLM provider)
# OPENAI_API_KEY=sk-...

# OpenAI-compatible endpoint (Ollama, LM Studio, OpenRouter, vLLM, ...)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini

# OpenRouter convenience: if only OPENROUTER_API_KEY is set, the test
# loader auto-points OPENAI_BASE_URL at OpenRouter and uses
# openai/gpt-4o-mini.
# OPENROUTER_API_KEY=sk-or-...

# LayerLens API key. The legacy sample end-to-end test mocks the Stratix
# client; the live adapter suite below uses a REAL client against staging.
# LAYERLENS_STRATIX_API_KEY=...

# ---------------------------------------------------------------------------
# Live provider-adapter verification (tests/e2e/live/ — see its README).
# Opt-in and never runs in CI. Real provider calls + a real staging backend.
# ---------------------------------------------------------------------------

# Opt the suite in (or pass `-m live`). Without this, every live test skips.
# LAYERLENS_LIVE=1

# Staging LayerLens. BASE_URL is required — the suite refuses the default (prod) URL.
# LAYERLENS_STRATIX_BASE_URL=https://<staging-host>/api/v1
# LAYERLENS_APP_BASE_URL=https://app.layerlens.ai   # UI base for report deep-links
# LAYERLENS_LIVE_COST_CAP_USD=0.25                  # per-test spend ceiling

# Provider credentials (set the ones you want to exercise; others skip).
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# GOOGLE_CLOUD_PROJECT=...            # or GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
# AWS_ACCESS_KEY_ID=...               # or AWS_PROFILE=...; plus AWS_REGION=us-east-1
# OLLAMA_HOST=http://localhost:11434  # also requires a running `ollama serve`
# LITELLM_API_KEY=...                 # or reuse OPENAI_API_KEY / ANTHROPIC_API_KEY

# Optional per-provider model overrides:
# LL_ANTHROPIC_MODEL, LL_OPENAI_MODEL, LL_VERTEX_MODEL, LL_BEDROCK_MODEL,
# OLLAMA_MODEL, LITELLM_MODEL, AZURE_OPENAI_API_VERSION
