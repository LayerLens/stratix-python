# =============================================================================
# Live adapter suite — env template.  Copy to `.env` (git-ignored) and fill the
# values you have; anything left blank simply auto-skips that adapter.
#   cp tests/e2e/live/.env.example tests/e2e/live/.env
#   set -a; source tests/e2e/live/.env; set +a
# This file is a TEMPLATE — never put real secrets here.
# =============================================================================

# --- Suite controls (required) -----------------------------------------------
LAYERLENS_LIVE=1
# NOTE the /api/v1 suffix. Local: http://localhost:8080/api/v1
LAYERLENS_STRATIX_BASE_URL=https://your-backend.example/api/v1
LAYERLENS_STRATIX_API_KEY=             # app API key value (x-api-key) for your org

# Optional suite knobs
# LAYERLENS_LIVE_COST_CAP_USD=0.25      # per-test spend ceiling (default 0.25)
# LAYERLENS_LIVE_KEEP_TRACES=1          # keep uploaded traces (skip teardown)
# LAYERLENS_APP_BASE_URL=https://stratix.layerlens.ai   # UI base for report deep-links

# --- Inbound-linkage assertions (optional) -----------------------------------
# Set to a registered sdk_adapter integration id to assert each uploaded trace
# links to it (and reaches Healthy). Unset = linkage recorded, not asserted.
# LAYERLENS_LIVE_INTEGRATION_ID=
# LAYERLENS_LIVE_LINKAGE_POLL_STATUS=1  # set 0 to assert only the id link (skip status poll)

# --- Providers (fill the ones you want; each adapter skips if unset) ---------
ANTHROPIC_API_KEY=                      # provider: anthropic  (LL_ANTHROPIC_MODEL to override)
OPENAI_API_KEY=                         # provider: openai + most frameworks + litellm

# Azure OpenAI (provider: azure_openai). From the Azure portal → your Azure OpenAI
# resource → "Keys and Endpoint", plus a deployed model in Azure OpenAI Studio.
AZURE_OPENAI_ENDPOINT=                  # e.g. https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=                   # key1/key2 from the resource
AZURE_OPENAI_DEPLOYMENT=                # the *deployment name* (not model name), e.g. gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# Google Vertex (provider: google_vertex). Needs a GCP project with Vertex AI
# enabled + ADC; set ONE of:
GOOGLE_CLOUD_PROJECT=                   # GCP project id (uses Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=         # OR absolute path to a service-account JSON
# LL_VERTEX_MODEL=gemini-1.5-flash

# Google Gemini API key (NOT used by the google_vertex provider; used by
# google_adk / litellm-gemini style paths)
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# AWS Bedrock (provider: bedrock; also bedrock_agents/strands). Needs an account
# with Bedrock *model access enabled* for the target model (the default Anthropic
# Bedrock model requires the use-case form). bedrock_agents additionally needs a
# *deployed* Bedrock Agent (agent id + alias).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# AWS_PROFILE=                          # alternative to access-key/secret
# LL_BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# Ollama (provider: ollama). Local, free. Requires `ollama serve` running.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# LiteLLM (provider: litellm) routes to one of OpenAI / Anthropic / LITELLM_API_KEY.
# LITELLM_API_KEY=
# LITELLM_MODEL=gpt-4o-mini

# --- Framework notes ---------------------------------------------------------
# Most frameworks (langchain, langgraph, openai_agents, crewai, semantic_kernel,
# llamaindex, smolagents, agno, autogen, embedding) use OPENAI_API_KEY above.
# vector_store is LLM-free (in-process Chroma). google_adk needs Google creds.
# Deferred (need a SaaS account, not covered by this suite):
#   agentforce -> a Salesforce org + Agentforce/Data-Cloud credentials
#   langfuse   -> a Langfuse instance (host + public key + secret key)

# --- Optional model overrides (cheap defaults already used by scenarios) -----
# LL_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# LL_OPENAI_MODEL=gpt-4o-mini
# LL_EMBED_MODEL=text-embedding-3-small

# Langfuse (batch sync adapter) — API keys for a DEDICATED test project; the
# live scenario writes (exports) a synthetic trace there and imports it back.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
